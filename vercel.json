{
  "redirects": [
    {
      "source": "/blog/cooperative-plumbing-drain-employee-owned-branding",
      "destination": "/blog/startup-branding-identity-guide",
      "permanent": true
    },
    {
      "source": "/portfolio/project/cooperative-plumbing-drain",
      "destination": "/portfolio/branding",
      "permanent": true
    },
    {
      "source": "/hub/:path*",
      "destination": "https://www.hunacreatives.com/hub/login",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "ops.hunacreatives.com"
        }
      ]
    },
    {
      "source": "/blog/web-design-that-converts-not-just-impresses",
      "destination": "/portfolio/web-design",
      "permanent": true
    },
    {
      "source": "/blog/website-design-for-small-businesses",
      "destination": "/portfolio/web-design",
      "permanent": true
    },
    {
      "source": "/blog/brand-strategy-before-design",
      "destination": "/blog/startup-branding-identity-guide",
      "permanent": true
    },
    {
      "source": "/blog/why-brand-identity-is-your-most-valuable-asset",
      "destination": "/blog/startup-branding-identity-guide",
      "permanent": true
    },
    {
      "source": "/blog/the-power-of-consistent-visual-branding",
      "destination": "/blog/the-second-haus-branding-consignment",
      "permanent": true
    },
    {
      "source": "/blog/social-media-marketing-that-actually-builds-your-brand",
      "destination": "/blog/social-media-content-strategy-2025",
      "permanent": true
    },
    {
      "source": "/blog/print-design-still-matters",
      "destination": "/blog/peak-coffee-roasters-branding-cebu-it-park",
      "permanent": true
    },
    {
      "source": "/for-agencies",
      "destination": "/sentro",
      "permanent": true
    },
    {
      "source": "/crewly",
      "destination": "/sentro",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/hub/sop/:id",
      "missing": [
        {
          "type": "query",
          "key": "spa"
        }
      ],
      "destination": "/api/sop-preview?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/hub",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/hub/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/q/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/c/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pay/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/status/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/smartgrid-dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/quote-requested",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
